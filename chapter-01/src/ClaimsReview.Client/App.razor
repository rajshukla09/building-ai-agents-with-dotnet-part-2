@using Microsoft.AspNetCore.Components.Routing
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">Claims Review</MudText>
        <MudSpacer />
        <MudButton Href="/">Submit Claim</MudButton>
        <MudButton Href="/claim-approvals">Pending Approvals</MudButton>
        <MudButton Href="/approved-claims">Approved Claims</MudButton>
    </MudAppBar>

    <MudMainContent Class="pa-6 mt-16">
        <Router AppAssembly="typeof(App).Assembly">
            <Found Context="routeData">
                <RouteView RouteData="@routeData" />
            </Found>
            <NotFound>
                <MudText Typo="Typo.h5">Page not found</MudText>
            </NotFound>
        </Router>
    </MudMainContent>
</MudLayout>
