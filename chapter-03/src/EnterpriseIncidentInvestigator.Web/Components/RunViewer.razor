<MudPaper Class="pa-5 mb-5 run-summary" Elevation="2">
    <div class="d-flex justify-space-between align-center"><MudText Typo="Typo.h5">Run @ShortId</MudText><MudChip T="string" Color="@StatusColor(Run.Run.Status)">@Run.Run.Status</MudChip></div>
    <MudGrid Class="mt-2"><MudItem xs="6" sm="3"><Metric Label="Started" Value="@Run.Run.StartedAt.ToLocalTime().ToString("T")" /></MudItem><MudItem xs="6" sm="3"><Metric Label="Completed" Value="@(Run.Run.CompletedAt?.ToLocalTime().ToString("T") ?? "—")" /></MudItem><MudItem xs="6" sm="3"><Metric Label="Duration" Value="@(Run.Run.DurationMilliseconds is null ? "Running" : $"{Run.Run.DurationMilliseconds} ms")" /></MudItem><MudItem xs="6" sm="3"><Metric Label="Confidence" Value="@(Run.Result is null ? "—" : $"{Run.Result.Confidence:P0}")" /></MudItem></MudGrid>
    <MudText Typo="Typo.body2" Class="mt-3"><b>Current agent:</b> @(CurrentAgent ?? "None") &nbsp; <b>Agent invocations:</b> @AgentCount / @Run.MaxAgentInvocations</MudText>
    @if (Run.Run.Status == "LimitReached") { <MudAlert Severity="Severity.Warning" Class="mt-3">Investigation stopped because the configured agent invocation limit was reached.</MudAlert> }
</MudPaper>
<MudPaper Class="pa-5 mb-5" Elevation="2"><MudText Typo="Typo.h5" Class="mb-4">Actual dynamic path</MudText><div class="route-path"><span>Supervisor</span>@foreach (var agent in AgentPath) { <b>↓</b><span>@agent</span> }@if (Run.Events.Any(x => x.EventType == "RootCauseGenerated")) { <b>↓</b><span>RootCauseAgent</span> }</div></MudPaper>
<MudText Typo="Typo.h5" Class="mb-3">Agent executions and nested MCP calls</MudText>
@foreach (var decision in Run.Events.Where(x => x.EventType == "SupervisorDecision")) { <AgentCard Decision="decision" Events="Run.Events.Where(x => x.AgentInvocationSequence == decision.AgentInvocationSequence).ToArray()" MaxTools="Run.MaxToolCallsPerAgent" /> }
<MudText Typo="Typo.h5" Class="mb-3">Execution timeline</MudText>
@foreach (var evt in Run.Events.OrderBy(x => x.Sequence)) { <TimelineEvent Event="evt" MaxTools="Run.MaxToolCallsPerAgent" /> }
@if (Run.Result is not null) { <MudPaper Class="pa-5 mt-5 root-cause" Elevation="4"><MudText Typo="Typo.overline">Final synthesis</MudText><MudText Typo="Typo.h4" Class="mb-3">Likely Root Cause</MudText><MudText>@Run.Result.RootCause</MudText><MudDivider Class="my-3"/><MudText><b>Evidence:</b> @Run.Result.Summary</MudText><MudText><b>Confidence:</b> @Run.Result.Confidence.ToString("P0")</MudText><MudText><b>Recommended action:</b> @Run.Result.Recommendation</MudText></MudPaper> }
@code { [Parameter, EditorRequired] public InvestigationRunView Run { get; set; } = null!; private string ShortId => Run.Run.RunId.ToString("N")[..8]; private IEnumerable<string> AgentPath => Run.Events.Where(x => x.EventType == "SupervisorDecision").Select(x => x.Agent!).Where(x => x is not null); private int AgentCount => Run.Events.Count(x => x.EventType == "SupervisorDecision"); private string? CurrentAgent => Run.Events.LastOrDefault(x => x.EventType == "AgentStarted" && !Run.Events.Any(y => y.AgentInvocationSequence == x.AgentInvocationSequence && y.EventType is "AgentCompleted" or "AgentFailed"))?.Agent; private static Color StatusColor(string s) => s switch { "Completed" => Color.Success, "Failed" => Color.Error, "LimitReached" => Color.Warning, _ => Color.Info }; }
